{
  "expo": {
    "name": "Sunlist",
    "slug": "SimpleTodo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "simpletodo",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeroninelab.simpletodo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F3"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.zeroninelab.simpletodo.app",
      "versionCode": 1,
      "permissions": ["android.permission.RECEIVE_BOOT_COMPLETED"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "./plugins/withWidgetStrings",
        {
          "label": "Sunlist · Today",
          "description": "See today's tasks on your home screen and check them off"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SimpleTodoWidget",
              "label": "@string/widget_label",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "description": "See today's tasks on your home screen and check them off",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7583212045442485~8015568499",
          "iosAppId": "ca-app-pub-7583212045442485~8015568499"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EE8F1F"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "69c7962b-1fb0-49a5-8c95-fa24863764db"
      }
    },
    "locales": {
      "ko": "./i18n/native/ko.json",
      "en": "./i18n/native/en.json",
      "ja": "./i18n/native/ja.json",
      "es": "./i18n/native/es.json"
    }
  }
}
